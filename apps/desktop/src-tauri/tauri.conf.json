{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Corollary",
  "version": "0.1.1",
  "identifier": "io.github.calvinyz.corollary",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Corollary",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI4QkQ0RUZBMDcyODY5MzUKUldRMWFTZ0grazY5dUNxNU41ZHZMOUlsSEVwZW55NmxheTVqbExKcEwwU1RPVXlmQVN2eUFudmkK",
      "endpoints": ["https://github.com/calvinyz/corollary/releases/latest/download/latest.json"]
    }
  }
}
